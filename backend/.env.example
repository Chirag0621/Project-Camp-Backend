# Server Environment
PORT=8000
NODE_ENV=production

# MongoDB Database Connection String (MongoDB Atlas URI in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/projectcamp?retryWrites=true&w=majority

# CORS Configuration - Allowed Frontend Origin(s) (comma-separated if multiple)
# In production, set this to your deployed frontend URL (e.g. https://your-frontend.vercel.app)
CORS_ORIGIN=http://localhost:5173

# JWT Authentication Secrets and Expiry
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
REFRESH_TOKEN_EXPIRY=10d

# Public Server URL (Used for static files / attachment URLs)
# In production, set to your backend service URL (e.g. https://your-backend.onrender.com)
SERVER_URL=http://localhost:8000

# Password Reset Redirect URL (Frontend route for reset password)
# In production, set to https://your-frontend.vercel.app/reset-password
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password

# Email Service (Mailtrap or SMTP like SendGrid / Resend / Gmail)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your_mailtrap_user
MAILTRAP_SMTP_PASS=your_mailtrap_password
